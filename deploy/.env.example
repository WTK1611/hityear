# Vorlage für /opt/party-music/.env auf dem Server (chmod 600).
# deploy/ausrollen.sh erzeugt die Datei mit zufälligen Werten – nicht ins Repo!

# Öffentliche Adresse (für QR-Codes)
ZEITSTRAHL_BASIS_URL=https://party-music.example.de

# Nur für den eigenen Caddy (--profile eigener-proxy)
PARTY_MUSIC_DOMAIN=party-music.example.de

# „passwort“: App erst nach Eingabe von ZEITSTRAHL_PASSWORT nutzbar (QR-Einladungen gelten weiter); leer = offen
ZEITSTRAHL_ZUGANG=
# Passwort für Mitspieler (privater Kreis) und für die Bibliothekspflege
ZEITSTRAHL_PASSWORT=
ZEITSTRAHL_ADMIN_PASSWORT=

# Schlüssel für Sitzungs-Cookies (64 Hex-Zeichen, z. B. openssl rand -hex 32)
ZEITSTRAHL_SECRET=


# Lautstärke der Ausschnitte angleichen (1 = an)
ZEITSTRAHL_LOUDNORM=1

# Lokaler Port am Host (nur 127.0.0.1)
ZEITSTRAHL_PORT=3700

# Statistik mit Matomo (nur nach Einwilligung im Banner); leer = aus, kein Banner
ZEITSTRAHL_MATOMO_URL=
ZEITSTRAHL_MATOMO_ID=
